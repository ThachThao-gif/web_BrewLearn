<mxCell id="nextReady" value="Chuyển yêu cầu sang chờ giao vòng tiếp theo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1370" width="370" height="65" as="geometry"/></mxCell>
<mxCell id="notifyReturn" value="Thông báo yêu cầu bổ sung cho trưởng ca" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1470" width="370" height="65" as="geometry"/></mxCell>
<mxCell id="notifyPlan" value="Thông báo kế hoạch cho nhân viên
và trưởng ca phụ trách" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1630" width="370" height="75" as="geometry"/></mxCell>
<mxCell id="check" value="Kiểm tra điều kiện hoàn thành của vòng hiện tại" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1830" width="370" height="65" as="geometry"/></mxCell>
<mxCell id="notifySchedule" value="Thông báo lịch đánh giá lại
cho nhân viên và trưởng ca đánh giá" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1930" width="370" height="75" as="geometry"/></mxCell>
<mxCell id="inc1" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u10" target="notifyApproved"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ext1" value="«extend»
[Đánh giá lại Đạt]" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="finish" target="u10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ext2" value="«extend»
[Chưa đạt, chưa có yêu cầu liên kết]" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="newPlan" target="u10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ext3" value="«extend»
[Đánh giá lại Chưa đạt]" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nextReady" target="u10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inc2" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u11" target="notifyReturn"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inc3" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u13" target="notifyPlan"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inc4" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="u16" target="notifyPlan"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inc5" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u15" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inc6" value="«include»" style="dashed=1;endArrow=open;endFill=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u15" target="notifySchedule"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n0" value="Tiền điều kiện chung: đã đăng nhập bằng tài khoản quản lý cửa hàng, trừ Đăng nhập.
Quản lý xem dữ liệu trong cửa hàng mình, có lọc theo ca.
Danh sách nguy cơ / đánh giá không bao gồm trưởng ca.
Trưởng ca vẫn được phân ca và giao phụ trách đào tạo lại." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="95" width="390" height="170" as="geometry"/></mxCell>
<mxCell id="n1" value="Hai nguồn độc lập:
1. Model dự đoán từ dữ liệu học tập / quiz.
2. Trưởng ca chấm năng lực theo 5 tiêu chí.
Quản lý xem riêng từng nguồn để cân nhắc.
Không gộp thành một điểm; không dùng điểm trưởng ca làm đầu vào tính nguy cơ.
Nguy cơ hỗ trợ ưu tiên xem hồ sơ." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="295" width="390" height="175" as="geometry"/></mxCell>
<mxCell id="n2" value="Trạng thái: Đang làm / Tạm ngưng / Nghỉ việc.
Tạm ngưng và nghỉ việc: không tính nhắc hạn và không chạy dự đoán mới; giữ lịch sử học và đánh giá.
Người đang làm nhưng chưa đủ điều kiện học vẫn xuất hiện trong danh sách nhắc hạn.
Nhắc đánh giá trong 7 ngày; nhắc hạn đào tạo lại trong 3 ngày." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="390" height="170" as="geometry"/></mxCell>
<mxCell id="n3" value="Chỉ duyệt / trả lại đánh giá đang chờ phê duyệt.
Giữ nguyên điểm và kết quả trưởng ca đã chấm.
Thiếu dữ liệu / cần làm rõ: trả lại kèm lý do.
Chưa đạt có đề xuất: tạo yêu cầu đào tạo lại hoặc chờ giao vòng tiếp theo.
Nhân viên nhận kết quả sau khi duyệt." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="700" width="390" height="150" as="geometry"/></mxCell>
<mxCell id="n4" value="Đề xuất đào tạo lại độc lập: chỉ duyệt / từ chối khi trạng thái Chờ duyệt.
Đề xuất trưởng ca gắn với đánh giá Chưa đạt được duyệt cùng đánh giá; không duyệt trùng.
Nguồn trưởng ca và nguồn model được lưu phân biệt." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="870" width="390" height="135" as="geometry"/></mxCell>
<mxCell id="n5" value="Giao kế hoạch: chọn trưởng ca phụ trách, nội dung, hạn hoàn thành và ngày dự kiến đánh giá lại." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="1530" width="390" height="75" as="geometry"/></mxCell>
<mxCell id="n6" value="Trước khi tạo lịch đánh giá lại: hoàn thành bài học / đạt quiz liên quan trong vòng hiện tại và có xác nhận thực hành / theo dõi của trưởng ca phụ trách." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="1730" width="390" height="85" as="geometry"/></mxCell>
<mxCell id="n7" value="Quản lý tạo lịch đánh giá lại, trưởng ca thực hiện chấm.
Vòng tiếp theo chỉ được giao sau khi kết quả Chưa đạt của vòng trước đã được duyệt.
Lưu riêng từng vòng: kế hoạch, xác nhận, đánh giá và kết quả duyệt.
Cập nhật kế hoạch đang thực hiện không tạo vòng mới; đổi người phụ trách / nội dung phải xác nhận lại.
Chỉ hoàn tất yêu cầu khi đánh giá lại Đạt được duyệt.
Thông báo quản lý không lặp cảnh báo nguy cơ đã có ở Dashboard." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF9D9;strokeColor=#C7B899;align=left;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="2050" width="390" height="175" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
