<mxCell id="finish" value="Hoàn tất yêu cầu đào tạo lại" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FAF7F2;strokeColor=#8C6D46;fontSize=14;fillColor=#E8F5E9;strokeColor=#388E3C;" vertex="1" parent="1"><mxGeometry x="1040" y="1170" width="370" height="65" as="geometry"/></mxCell>
