i học, đạt mọi bài kiểm tra bắt buộc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#333333;fontSize=13;spacingLeft=16;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1185" y="295" width="200" height="80" as="geometry"/></mxCell><mxCell id="s4_g" value="" style="shape=mxgraph.bpmn.service_task;html=1;outlineConnect=0;fillColor=#333333;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1191" y="301" width="14" height="14" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1450" y="310" width="50" height="50" as="geometry"/></mxCell><mxCell id="g1_l" value="Đủ điều kiện học tập?" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1390" y="365" width="170" height="24" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="s4" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Chưa đủ: học tiếp / thi lại bài chưa đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="40"/><mxPoint x="775" y="40"/></Array></mxGeometry></mxCell><mxCell id="end" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1