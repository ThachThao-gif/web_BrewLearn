value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="q4" target="end2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="Trưởng ca giữ hai vai trò theo phân công của quản lý: người phụ trách (xác nhận hoàn thành) và người chấm đánh giá lại; hai vai trò có thể do hai trưởng ca khác nhau đảm nhiệm. Chấm và phê duyệt đánh giá lại áp dụng cùng quy tắc với Hình 2.3." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=10;fillColor=#FFF8E1;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1125" width="1300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
