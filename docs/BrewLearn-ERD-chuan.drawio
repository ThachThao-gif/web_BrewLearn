        </mxCell>
        <mxCell id="04-tien-do-legend" value="Crow’s Foot  |  PK: khóa chính  |  UQ: duy nhất  |  FK: khóa ngoại MySQL  |  RL: liên kết theo code" style="text;align=left;verticalAlign=middle;spacingLeft=12;fontSize=20;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
