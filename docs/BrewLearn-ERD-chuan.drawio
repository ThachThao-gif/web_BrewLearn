        <mxCell id="06-ket-qua-footer" value="Tất cả cột và kiểu dữ liệu giữ nguyên từ MySQL. Chân quạ ở phía bảng chứa cột liên kết; đầu đối diện xác định bảng được tham chiếu." style="text;align=left;verticalAlign=middle;spacingLeft=12;fontSize=20;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
