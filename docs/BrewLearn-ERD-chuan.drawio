        <mxCell id="03-noi-dung-footer" value="Tất cả cột và kiểu dữ liệu giữ nguyên từ MySQL. Chân quạ ở phía bảng chứa cột liên kết; đầu đối diện xác định bảng được tham chiếu." style="text;align=left;verticalAlign=middle;spacingLeft=12;fontSize=20;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="4980.0" y="1130.0" width="2340" height="55" />
        </mxCell>
