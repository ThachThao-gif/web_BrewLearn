        <mxCell id="note-0" value="PK: khóa chính; FK: tham chiếu logic; NN: bắt buộc; NULL: cho phép trống." vertex="1" parent="1" style="text;align=left;fontSize=17;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="4160" y="2750" width="1130" height="38" />
        </mxCell>
        <mxCell id="note-1" value="Crow’s Foot: vòng tròn = 0; vạch = 1; chân quạ = nhiều. Cầu vượt KHÔNG phải điểm nối." vertex="1" parent="1" style="text;align=left;fontSize=17;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="4160" y="2790" width="1130" height="38" />
        </mxCell>
        <mxCell id="note-2" value="27 và 32: một–một tùy chọn. 28: một–nhiều theo schema (chưa có UNIQUE)." vertex="1" parent="1" style="text;align=left;fontSize=17;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="4160" y="2830" width="1130" height="38" />
        </mxCell>
        <mxCell id="note-3" value="Ba quan hệ N:N đã được biểu diễn qua bảng liên kết; không vẽ thêm đường trực tiếp." vertex="1" parent="1" style="text;align=left;fontSize=17;whiteSpace=wrap;">
          <mxGeometry as="geometry" x="4160" y="2870" width="1130" height="38" />
        </mxCell>
        <mxCell id="note-4" value="Tên thực thể Việt hóa trên ERD; liên kết logic không đồng nghĩa đã có FOREIGN KEY trong MySQL." vertex="1" parent="1" style="text;align=left;fontSize=17;whiteSpace=wrap;">
