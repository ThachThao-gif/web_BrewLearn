        <mxCell id="note" value="Ứng dụng web hiển thị kết quả dự đoán đã lưu. Chương trình Python được chạy độc lập với thao tác mở Dashboard." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=17;fontStyle=2;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1320" height="40" as="geometry"/></mxCell>
