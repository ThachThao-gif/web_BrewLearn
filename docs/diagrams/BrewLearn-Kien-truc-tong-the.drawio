        <mxCell id="browser" value="&lt;b&gt;TRÌNH DUYỆT WEB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiển thị giao diện&lt;br&gt;Tiếp nhận thao tác người dùng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#375a7f;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="250" height="280" as="geometry"/></mxCell>
        <mxCell id="laravel" value="&lt;b&gt;ỨNG DỤNG LARAVEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xác thực và xử lý yêu cầu&lt;br&gt;Học tập và kiểm tra&lt;br&gt;Đánh giá và phê duyệt&lt;br&gt;Quản lý đào tạo lại&lt;br&gt;Tổng hợp Dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#375a7f;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="300" height="280" as="geometry"/></mxCell>
        <mxCell id="mysql" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhân viên và cửa hàng&lt;br&gt;Học tập và kiểm tra&lt;br&gt;Đánh giá và đào tạo lại&lt;br&gt;Kết quả dự đoán" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#fff4d6;strokeColor=#9b7625;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;spacingTop=20;spacing=10;" vertex="1" parent="1"><mxGeometry x="1130" y="200" width="220" height="280" as="geometry"/></mxCell>
        <mxCell id="python" value="&lt;b&gt;CHƯƠNG TRÌNH PYTHON&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tổng hợp chỉ số học tập và kiểm tra&lt;br&gt;Kiểm tra dữ liệu và thực hiện dự đoán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf5ed;strokeColor=#4e7451;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;spacing=10;" vertex="1" parent="1"><mxGeometry x="940" y="625" width="370" height="105" as="geometry"/></mxCell>
