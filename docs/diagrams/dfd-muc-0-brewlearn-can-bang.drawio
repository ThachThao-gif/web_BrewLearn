<mxCell id="legend" value="Kho lặp cùng mã là cùng một kho logic. Tiến trình 5.0 là chương trình Python được lập lịch chạy hằng đêm, chỉ ghi kết quả vào D5 và không ghi vào D4." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontColor=#263238;fillColor=#ffffff;spacing=2;" vertex="1" connectable="0" parent="1"><mxGeometry x="350" y="1280" width="1250" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
