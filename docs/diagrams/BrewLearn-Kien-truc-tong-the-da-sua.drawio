  <diagram id="brewlearn-architecture" name="Kiến trúc tổng thể">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KIẾN TRÚC TỔNG THỂ HỆ THỐNG BREWLEARN" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1350" height="50" as="geometry"/></mxCell>

        <mxCell id="user-zone" value="NGƯỜI DÙNG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;spacingTop=12;fontFamily=Times New Roman;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="230" height="380" as="geometry"/></mxCell>
        <mxCell id="web-zone" value="ỨNG DỤNG WEB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;spacingTop=12;fontFamily=Times New Roman;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="740" height="380" as="geometry"/></mxCell>
        <mxCell id="rule-zone" value="THÀNH PHẦN TÍNH CẢNH BÁO TỰ ĐỘNG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;verticalAlign=top;spacingTop=12;fontFamily=Times New Roman;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="820" height="210" as="geometry"/></mxCell>

        <mxCell id="employee" value="Nhân viên" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="leader" value="Trưởng ca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="170" height="56" as="geometry"/></mxCell>
        <mxCell id="manager" value="Quản lý cửa hàng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="170" height="56" as="geometry"/></mxCell>

        <mxCell id="browser" value="&lt;b&gt;TRÌNH DUYỆT WEB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hiển thị giao diện&lt;br&gt;Tiếp nhận thao tác người dùng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#375a7f;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="260" height="280" as="geometry"/></mxCell>
        <mxCell id="laravel" value="&lt;b&gt;ỨNG DỤNG LARAVEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Xác thực và phân quyền&lt;br&gt;Học tập và kiểm tra&lt;br&gt;Đánh giá và phê duyệt&lt;br&gt;Quản lý đào tạo lại&lt;br&gt;Thông báo và nhắc việc&lt;br&gt;Tổng hợp Dashboard&lt;br&gt;Hiển thị cảnh báo đã lưu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#375a7f;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="150" width="270" height="300" as="geometry"/></mxCell>
        <mxCell id="mysql" value="&lt;b&gt;CƠ SỞ DỮ LIỆU&lt;br&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nhân viên và cửa hàng&lt;br&gt;Học tập và kiểm tra&lt;br&gt;Đánh giá và đào tạo lại&lt;br&gt;Thông báo và hỗ trợ&lt;br&gt;Kết quả cảnh báo" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=20;fillColor=#fff2b3;strokeColor=#9a7d0a;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="270" height="300" as="geometry"/></mxCell>

        <mxCell id="operator" value="&lt;b&gt;LỊCH CHẠY TỰ ĐỘNG&lt;/b&gt;&lt;br&gt;Laravel Scheduler&lt;br&gt;01:00 hằng đêm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=17;" vertex="1" parent="1"><mxGeometry x="620" y="615" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="python" value="&lt;b&gt;CHƯƠNG TRÌNH PYTHON&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đọc tiến độ học và kết quả kiểm tra&lt;br&gt;Kiểm tra đủ dữ liệu&lt;br&gt;Tính điểm theo bộ luật rules-v2&lt;br&gt;Xếp mức Thấp / Trung bình / Cao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf5ed;strokeColor=#4e7451;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=16;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="300" height="140" as="geometry"/></mxCell>

        <mxCell id="note" value="Ứng dụng web chỉ đọc kết quả cảnh báo đã lưu để hiển thị. Chương trình Python được lập lịch chạy tự động lúc 01:00 hằng đêm (có thể chạy ngay bằng lệnh php artisan brewlearn:calculate-risk), độc lập với thao tác mở Dashboard." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Times New Roman;fontSize=16;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="765" width="1350" height="40" as="geometry"/></mxCell>

