=12;spacingRight=8;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="3275" y="595" width="335" height="70" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#64748b;strokeWidth=1.5;exitX=0.5;exitY=0.38461538461538464;entryX=0;entryY=0.5;" edge="1" parent="1" source="sp7" target="b7_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b7_3" value="8.4  Gửi giao vòng / lịch đánh giá lại" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=18;align=left;spacingLeft=12;spacingRight=8;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="3275" y="695" width="335" height="70" as="geometry"/></mxCell><mxCell id="e64" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#64748b;strokeWidth=1.5;exitX=0.5;exitY=0.5384615384615384;entryX=0;entryY=0.5;" edge="1" parent="1" source="sp7" target="b7_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b7_4" value="8.5  Xem, đánh dấu đọc / xóa thông báo" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=18;align=left;spacingLeft=12;spacingRight=8;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="3275" y="795" width="335" height="70" as="geometry"/></mxCell><mxCell id="e65" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#64748b;strokeWidth=1.5;exitX=0.5;exitY=0.6923076923076923;entryX=0;entryY=0.5;" edge="1" parent="1" source="sp7" target="b7_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b7_5" value="8.6  Ghi nhận lỗi / sự cố nghiệp vụ" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=18;align=left;spacingLeft=12;spacingRight=8;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="3275" y="895" width="335" height="70" as="geometry"/></mxCell><mxCell id="e66" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#64748b;strokeWidth=1.5;exitX=0.5;exitY=0.8461538461538461;entryX=0;entryY=0.5;" edge="1" parent="1" source="sp7" target="b7_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b7_6" value="8.7  Gửi và xem yêu cầu hỗ trợ" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=18;align=left;spacingLeft=12;spacingRight=8;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="3275" y="995" width="335" height="70" as="geometry"/></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;startArrow=none;strokeColor=#64748b;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="sp7" target="b7_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="BFD thể hiện phân cấp chức năng; đường nối không có mũi tên và không biểu diễn trình tự xử lý.&#xa;Phạm vi hiện có: Nhân viên — Trưởng ca — Quản lý cửa hàng. Khóa học / quiz đã có trong database; không thêm HR, quản lý vùng, biên soạn khóa hoặc ngân hàng câu hỏi.&#xa;Model chỉ dùng dữ liệu học tập / quiz, chạy bằng script riêng; không tính lại nguy cơ từ đánh giá trưởng ca. Trưởng ca tự học / kiểm tra, không thuộc danh sách bị đánh giá hoặc dự đoán.&#xa;Thông báo kết quả cho nhân viên sau khi quản lý duyệt; giữ lịch sử từng vòng đào tạo lại và chỉ đóng khi đánh giá lại Đạt đã được duyệt." style="shape=note;fillColor=#fff2cc;strokeColor=#bca984;fontSize=18;align=left;spacing=14;;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="1250" width="3540" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
